# ═══════════════════════════════════════════════════════════════
# Online Banking Simulation — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════

# Database Configuration (MySQL 8.0)
# Note: If host has native MySQL running on 3306, set MYSQL_PORT=3307 to avoid collisions
MYSQL_ROOT_PASSWORD=change_me_database_password#rootpassword(old password)
MYSQL_DATABASE=online_banking
MYSQL_USERNAME=onlinebanking
MYSQL_PASSWORD=change_me_database_password#onlinebanking(old password)
MYSQL_PORT=3307

# Keycloak Identity Provider (Keycloak 24.0)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password#admin(old password)
KEYCLOAK_PORT=9090

# Spring Boot Backend API
# Note: If host has XAMPP/Apache running on 8080, set BACKEND_PORT=8081 to avoid collisions
BACKEND_PORT=8081

# Angular Frontend & Nginx Reverse Proxy
FRONTEND_PORT=80

